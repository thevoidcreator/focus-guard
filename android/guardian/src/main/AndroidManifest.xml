<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<queries><package android:name="com.whatsapp" /></queries>
<application android:icon="@drawable/guardian_icon" android:label="Focus Guard — Подтверждение" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/extraction">
<provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true"><meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/transfer_paths" /></provider>
<activity android:name=".GuardianActivity" android:exported="true" android:launchMode="singleTask">
<intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
<intent-filter><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.DEFAULT" /><data android:scheme="content" /><data android:mimeType="application/json" /><data android:mimeType="application/octet-stream" /><data android:mimeType="text/plain" /><data android:mimeType="text/json" /><data android:mimeType="application/x-json" /></intent-filter>
<intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="*/*" /></intent-filter>
</activity></application></manifest>
