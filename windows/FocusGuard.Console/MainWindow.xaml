<Window x:Class="FocusGuard.ConsoleApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus Guard — Восстановление" Width="1040" Height="820" MinWidth="780" MinHeight="650" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}">
<Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<DockPanel Margin="0,0,0,24"><Button x:Name="Theme" DockPanel.Dock="Right" Click="ToggleTheme"/><TextBlock Text="Focus Guard" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
<StackPanel Grid.Row="1" Margin="0,0,0,16"><TextBlock x:Name="Progress" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="Heading" FontSize="30" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="Description" Foreground="{DynamicResource Muted}" FontSize="16"/></StackPanel>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Body" Margin="0,0,12,12"/></ScrollViewer>
<StackPanel Grid.Row="3"><TextBlock x:Name="Status" Foreground="{DynamicResource Accent}" Margin="0,10"/><DockPanel><Button x:Name="NextButton" DockPanel.Dock="Right" Background="{DynamicResource Accent}" Foreground="{DynamicResource ButtonInk}" Click="Next" MinWidth="210"/><Button x:Name="BackButton" DockPanel.Dock="Left" Content="Назад" Click="Back"/><TextBlock Text="0.3 · тестовая версия" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel></StackPanel>
</Grid></Window>
