<Window x:Class="FocusGuard.ConsoleApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Focus Guard — USB Key Console" Width="1120" Height="900" MinWidth="820" MinHeight="650" Background="#F4F6F8">
<Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock Text="Focus Guard" FontSize="28" FontWeight="Bold"/><TextBlock Text="Windows 11 • USB-ключ"/><Button Content="Настроить USB-ключ" Tag="setup" Click="Navigate"/><Button Content="Привязать телефон" Tag="enrollment" Click="Navigate"/><Button Content="Начать удаление" Tag="removal_start" Click="Navigate"/><Button Content="Завершить удаление" Tag="removal_finish" Click="Navigate"/><Button Content="Изменить политику" Tag="policy_change" Click="Navigate"/><Button Content="Аварийное подтверждение" Tag="emergency_release" Click="Navigate"/><Button Content="Проверить ключ" Tag="verify" Click="Navigate"/><TextBlock Text="Обычная флешка копируется. Резервная копия даёт те же права. Извлечение не отзывает уже выданный ответ."/><TextBlock Text="Production Android закрыт до проверки выхода на конкретном телефоне."/></StackPanel>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="16,0,0,0">
<TextBlock x:Name="Heading" Text="Настроить USB-ключ" FontSize="25" FontWeight="SemiBold"/>
<TextBlock Text="Съёмный носитель (без форматирования):"/><DockPanel><Button DockPanel.Dock="Right" Content="Обновить" Click="RefreshDrives"/><ComboBox x:Name="Drives" Margin="4" SelectionChanged="DriveChanged"/></DockPanel>
<TextBlock x:Name="DriveDetails"/><TextBlock Text="Папка существующего ключа на выбранном носителе:"/><ComboBox x:Name="Keys" Margin="4" SelectionChanged="KeyChanged"/>
<TextBlock x:Name="KeyDetails" FontFamily="Consolas"/>
<StackPanel x:Name="SetupPanel"><TextBlock Text="Роль нового ключа:"/><ComboBox x:Name="NewRole" SelectedIndex="0" Margin="4"><ComboBoxItem Content="Основной — мой USB"/><ComboBoxItem Content="Аварийный — отдельный USB доверенного человека"/></ComboBox><TextBlock Text="Пароль контейнера — минимум 12 символов. Храните отдельно. Ключи создаются в новой папке, существующие не перезаписываются."/><TextBlock Text="Повторите пароль для нового ключа:"/><PasswordBox x:Name="RepeatPassword" Margin="4" Padding="8"/><Button Content="Создать ключ и проверить чтение/подпись" Click="CreateKey"/></StackPanel>
<TextBlock Text="Пароль ключа (заново для каждой операции):"/><PasswordBox x:Name="Password" Margin="4" Padding="8"/>
<StackPanel x:Name="VerifyPanel" Visibility="Collapsed"><Button Content="Проверить ключ пробной подписью" Click="VerifyKey"/><TextBlock Text="Резервная копия — только на другой съёмный носитель:"/><ComboBox x:Name="BackupDrives" Margin="4"/><CheckBox x:Name="BackupAck" Content="Понимаю: копия обладает теми же полномочиями" Margin="4"/><Button Content="Создать и сверить резервную копию" Click="BackupKey"/></StackPanel>
<StackPanel x:Name="RequestPanel" Visibility="Collapsed"><TextBlock Text="Запрос телефона — QR с камеры или файл .fgreq:"/><WrapPanel><Button Content="Считать веб-камерой" Click="ScanCamera"/><Button Content="Импортировать запрос" Click="ImportRequest"/><Button Content="Проверить запрос" Click="InspectRequest"/></WrapPanel><TextBox x:Name="Request" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock x:Name="RequestDetails" FontFamily="Consolas"/><CheckBox x:Name="Confirm" Content="Сверил телефон, действие и fingerprint ключа; понимаю последствия" Margin="4"/><Button Content="Подписать ответ выбранным USB-ключом" Click="SignRequest"/></StackPanel>
<TextBlock x:Name="Status" Foreground="#853000" FontWeight="SemiBold"/>
<Image x:Name="Qr" Width="620" Height="620" Stretch="Uniform"/>
<TextBox x:Name="Output" IsReadOnly="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><Button Content="Экспортировать публичный ответ / метаданные" Click="ExportOutput"/>
</StackPanel></ScrollViewer></Grid></Window>
