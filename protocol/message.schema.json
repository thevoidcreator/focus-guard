{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Focus Guard Message v1","type":"object","additionalProperties":false,"required":["protocolVersion","messageType","installationId","requestId","nonce","keyId","phoneKeyId","policyVersion","removalFlowId","phase","requestDigest","role","publicKey","proposal"],"properties":{"protocolVersion":{"const":1},"messageType":{"enum":["enrollment","removal_start","removal_finish","policy_change","emergency_release"]},"installationId":{"type":"string","minLength":1,"maxLength":64},"requestId":{"type":"string","minLength":1,"maxLength":64},"nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"keyId":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"phoneKeyId":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},"policyVersion":{"type":"integer","minimum":1},"removalFlowId":{"type":"string","maxLength":64},"phase":{"enum":["request_start","request_finish","response"]},"requestDigest":{"type":"string","pattern":"^([A-Za-z0-9_-]{43})?$"},"role":{"enum":["main","emergency"]},"publicKey":{"type":"string","maxLength":256},"proposal":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/policy"}]}},"$defs":{"policy":{"type":"object","additionalProperties":false,"required":["zone","sessionMs","apps","mainSpki","emergencySpki"],"properties":{"zone":{"type":"string"},"sessionMs":{"type":"integer","minimum":60000,"maximum":86400000},"mainSpki":{"type":"string","maxLength":256},"emergencySpki":{"type":"string","maxLength":256},"apps":{"type":"array","maxItems":100,"items":{"type":"object","additionalProperties":false,"required":["packageId","certificateSha256"],"properties":{"packageId":{"type":"string","pattern":"^[a-zA-Z0-9_.]+$"},"certificateSha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}}}}}
